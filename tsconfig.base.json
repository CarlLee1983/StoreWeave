{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": false,
    "sourceMap": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@storeweave/contracts": ["packages/platform/contracts/src/index.ts"],
      "@storeweave/config": ["packages/platform/config/src/index.ts"],
      "@storeweave/db": ["packages/platform/db/src/index.ts"],
      "@storeweave/command-bus": ["packages/platform/command-bus/src/index.ts"],
      "@storeweave/query-bus": ["packages/platform/query-bus/src/index.ts"],
      "@storeweave/event-bus": ["packages/platform/event-bus/src/index.ts"],
      "@storeweave/outbox": ["packages/platform/outbox/src/index.ts"],
      "@storeweave/jobs": ["packages/platform/jobs/src/index.ts"],
      "@storeweave/authorization": ["packages/platform/authorization/src/index.ts"],
      "@storeweave/identity": ["packages/platform/identity/src/index.ts"],
      "@storeweave/audit": ["packages/platform/audit/src/index.ts"],
      "@storeweave/extension-sdk": ["packages/platform/extension-sdk/src/index.ts"],
      "@storeweave/kernel": ["packages/platform/kernel/src/index.ts"],
      "@storeweave/bundle": ["packages/platform/bundle/src/index.ts"],
      "@storeweave/api": ["apps/api/src/index.ts"],
      "@storeweave/catalog": ["packages/commerce/catalog/src/index.ts"],
      "@storeweave/inventory": ["packages/commerce/inventory/src/index.ts"],
      "@storeweave/order": ["packages/commerce/order/src/index.ts"],
      "@storeweave/customer": ["packages/commerce/customer/src/index.ts"],
      "@storeweave/cart": ["packages/commerce/cart/src/index.ts"],
      "@storeweave/shipping": ["packages/commerce/shipping/src/index.ts"],
      "@storeweave/coupon": ["packages/commerce/coupon/src/index.ts"],
      "@storeweave/loyalty": ["packages/commerce/loyalty/src/index.ts"],
      "@storeweave/promotion": ["packages/commerce/promotion/src/index.ts"],
      "@storeweave/ext-mock-payment": ["packages/extensions/mock-payment/src/index.ts"],
      "@storeweave/ext-ecpay": ["packages/extensions/ecpay/src/index.ts"],
      "@storeweave/ext-mock-notification": ["packages/extensions/mock-notification/src/index.ts"],
      "@storeweave/ext-demo-erp": ["packages/extensions/demo-erp/src/index.ts"],
      "@storeweave/ext-mcp": ["packages/extensions/mcp/src/index.ts"],
      "@storeweave/theme-default": ["packages/themes/default/src/index.ts"]
    }
  }
}
