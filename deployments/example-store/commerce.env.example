# 複製成 /etc/commerce/commerce.env，owner 設 root:commerce、權限設 0640，且永遠不要進版控。
DATABASE_URL=postgres://commerce:change-me@127.0.0.1:5432/commerce
COMMERCE_PUBLIC_URL=http://localhost:3000

# 身分連結與下載連結的簽章金鑰。至少 32 bytes（openssl rand -base64 32）。移除一把金鑰等於立即作廢它簽過的所有連結。
COMMERCE_SIGNING_KEY_K1=replace-with-32-bytes-base64url

# demo-erp Extension 宣告的必要機密
DEMO_ERP_API_KEY=replace-with-erp-api-key

# Required only when mail.transport is smtp.
COMMERCE_SMTP_HOST=smtp.example.com
COMMERCE_SMTP_USERNAME=replace-with-smtp-username
COMMERCE_SMTP_PASSWORD=replace-with-smtp-password
