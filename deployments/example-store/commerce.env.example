# 複製成 /etc/commerce/commerce.env，權限設 0600，且永遠不要進版控。
DATABASE_URL=postgres://commerce:change-me@127.0.0.1:5432/commerce
COMMERCE_PUBLIC_URL=http://localhost:3000

# API token：請用 `openssl rand -hex 32` 產生
COMMERCE_ADMIN_TOKEN=replace-with-a-long-random-string
COMMERCE_MCP_TOKEN=replace-with-another-long-random-string

# demo-erp Extension 宣告的必要機密
DEMO_ERP_API_KEY=replace-with-erp-api-key
