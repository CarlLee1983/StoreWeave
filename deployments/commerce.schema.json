{
  "$ref": "#/definitions/CommerceConfig",
  "definitions": {
    "CommerceConfig": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "store": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "locale": {
              "type": "string",
              "default": "zh-TW"
            },
            "timezone": {
              "type": "string",
              "default": "Asia/Taipei"
            },
            "supportEmail": {
              "type": "string",
              "format": "email"
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3,
              "default": "TWD"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "http": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string",
              "default": "0.0.0.0"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535,
              "default": 3000
            },
            "publicUrl": {
              "type": "string",
              "format": "uri",
              "default": "http://localhost:3000"
            },
            "cors": {
              "type": "object",
              "properties": {
                "allowedOrigins": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  },
                  "default": []
                },
                "credentials": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false,
              "default": {}
            },
            "trustProxy": {
              "type": "boolean",
              "default": false
            },
            "bodyLimitBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 1048576
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "database": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "poolSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "ssl": {
              "type": "boolean",
              "default": false
            },
            "autoMigrate": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64,
              "default": 4
            },
            "pollIntervalMs": {
              "type": "integer",
              "minimum": 50,
              "default": 1000
            },
            "outboxBatchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "staleLockSeconds": {
              "type": "integer",
              "minimum": 10,
              "default": 300
            },
            "completedPayloadRetentionDays": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 7
            },
            "cancelledPayloadRetentionDays": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 7
            },
            "dedupeHorizonDays": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 30
            },
            "retentionCleanupBatchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "cache": {
          "type": "object",
          "properties": {
            "cleanupBatchSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 500
            },
            "cleanupIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 86400000,
              "default": 60000
            },
            "lockRetryIntervalMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 25
            },
            "mutexPoolSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 2
            },
            "mutexConnectionTimeoutMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000,
              "default": 5000
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "storage": {
          "type": "object",
          "properties": {
            "driver": {
              "type": "string",
              "enum": [
                "local",
                "s3"
              ],
              "default": "local"
            },
            "localRoot": {
              "type": "string",
              "minLength": 1
            },
            "maxUploadBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824,
              "default": 20971520
            },
            "signedUrlTtlSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600,
              "default": 300
            },
            "cleanupIntervalMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 86400000,
              "default": 60000
            },
            "staleObjectSeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800,
              "default": 3600
            },
            "s3": {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 255
                },
                "region": {
                  "type": "string",
                  "minLength": 1,
                  "default": "us-east-1"
                },
                "endpoint": {
                  "type": "string",
                  "format": "uri"
                },
                "forcePathStyle": {
                  "type": "boolean",
                  "default": false
                },
                "prefix": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
                },
                "accessKeyIdRef": {
                  "type": "string",
                  "minLength": 1
                },
                "secretAccessKeyRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "bucket",
                "accessKeyIdRef",
                "secretAccessKeyRef"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "mail": {
          "type": "object",
          "properties": {
            "transport": {
              "type": "string",
              "enum": [
                "disabled",
                "smtp"
              ],
              "default": "disabled"
            },
            "from": {
              "type": "string",
              "format": "email"
            },
            "smtp": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535,
                  "default": 587
                },
                "secure": {
                  "type": "boolean",
                  "default": false
                },
                "usernameRef": {
                  "type": "string",
                  "minLength": 1
                },
                "passwordRef": {
                  "type": "string",
                  "minLength": 1
                },
                "connectionTimeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 55000,
                  "default": 10000
                },
                "socketTimeoutMs": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 55000,
                  "default": 30000
                }
              },
              "required": [
                "host"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "shutdown": {
          "type": "object",
          "properties": {
            "timeoutMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 25000
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "theme": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "default": "default"
            },
            "options": {
              "type": "object",
              "additionalProperties": {},
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "admin": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "basePath": {
              "type": "string",
              "pattern": "^\\/",
              "default": "/admin"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "mcp": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "path": {
              "type": "string",
              "pattern": "^\\/",
              "default": "/mcp"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "auth": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "admin",
                      "staff",
                      "readonly",
                      "mcp"
                    ]
                  },
                  "secretRef": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "name",
                  "role",
                  "secretRef"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "sessionTtlMinutes": {
              "type": "object",
              "properties": {
                "operator": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 43200,
                  "default": 720
                },
                "customer": {
                  "type": "integer",
                  "minimum": 5,
                  "maximum": 525600,
                  "default": 43200
                }
              },
              "additionalProperties": false,
              "default": {}
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{2,63}$"
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "config": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "logging": {
          "type": "object",
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error"
              ],
              "default": "info"
            },
            "destination": {
              "type": "string",
              "enum": [
                "stdout",
                "file"
              ],
              "default": "stdout"
            },
            "file": {
              "type": "string",
              "default": "/var/log/commerce/commerce.log"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "paths": {
          "type": "object",
          "properties": {
            "dataDir": {
              "type": "string",
              "default": "/var/lib/commerce"
            },
            "backupDir": {
              "type": "string",
              "default": "/var/lib/commerce/backups"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "secrets": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "env",
                "file"
              ],
              "default": "env"
            },
            "file": {
              "type": "string",
              "default": "/etc/commerce/commerce.env"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "security": {
          "type": "object",
          "properties": {
            "signingKeys": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{0,63}$"
                  },
                  "secretRef": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "secretRef"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "activeSigningKeyId": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "version",
        "store",
        "database"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StoreWeave commerce.yaml",
  "description": "Release 設定檔結構。機密使用 ${ENV_VAR} 參照。"
}
