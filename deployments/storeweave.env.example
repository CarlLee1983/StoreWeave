# Copy to /etc/storeweave/storeweave.env with root:storeweave ownership and mode 0640.
STOREWEAVE_DATABASE_URL=postgres://storeweave:change-me@127.0.0.1:5432/storeweave
# 簽章金鑰：至少 32 bytes，base64url 或 hex。輪替是「加一把、改 activeSigningKeyId、
# 等舊連結到期、再移除」，所以這裡可以同時有多把。
STOREWEAVE_SIGNING_KEY_K1=change-me-generate-with-openssl-rand-base64-32
# Configure SMTP references only when `mail.transport: smtp` is selected.
