{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "../../node_modules/.cache/storeweave-admin.tsbuildinfo",
    "types": [],
    "baseUrl": "../..",
    "paths": {
      "@storeweave/i18n": ["packages/platform/i18n/src/index.ts"],
      "@storeweave/order/http": ["packages/commerce/order/src/http.ts"],
      "@storeweave/shipping": ["packages/commerce/shipping/src/dto.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
