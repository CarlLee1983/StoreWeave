{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/storeweave.tsbuildinfo"
  },
  "include": [
    "apps/api/src/**/*.ts",
    "apps/worker/src/**/*.ts",
    "packages/**/src/**/*.ts",
    "tools/**/src/**/*.ts",
    "packages/**/test/**/*.ts",
    "tests/**/*.ts",
    "scripts/seed.ts",
    "scripts/seeds/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "release", "apps/admin"]
}
